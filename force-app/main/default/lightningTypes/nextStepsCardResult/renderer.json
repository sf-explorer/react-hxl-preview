          "summaryTitle": "{!$attrs.outputValues.nextSteps.summaryTitle}",
          "summaryDetail": "{!$attrs.outputValues.nextSteps.summaryDetail}",
          "stepsCaption": "{!$attrs.outputValues.nextSteps.stepsCaption}",
          "steps": "{!$attrs.outputValues.nextSteps.steps}",
          "showCta": "{!$attrs.outputValues.nextSteps.showCta}",
          "ctaLabel": "{!$attrs.outputValues.nextSteps.ctaLabel}",
          "ctaUrl": "{!$attrs.outputValues.nextSteps.ctaUrl}"
        }
      }
    }
  }
}
