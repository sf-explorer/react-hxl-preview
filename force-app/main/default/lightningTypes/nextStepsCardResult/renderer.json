{
  "renderer": {
    "componentOverrides": {
      "$": {
        "definition": "@widget/c/nextStepsCard",
        "attributes": {
          "title": "{!$attrs.outputValues.nextSteps.title}",
          "subtitle": "{!$attrs.outputValues.nextSteps.subtitle}",
          "badges": "{!$attrs.outputValues.nextSteps.badges}",
